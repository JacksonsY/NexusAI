<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nexusai</groupId>
        <artifactId>nexusai</artifactId>
        <version>${revision}</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>nexusai-persistence-log-pg</artifactId>
    <packaging>jar</packaging>
    <name>nexusai-persistence-log-pg</name>
    <description>日志域存储 driver（store=pg）：MyBatis-Plus + nai_request_log；PgRequestLogStore 实现 RequestLogStore，分位/分桶用 PG 方言。</description>

    <dependencies>
        <dependency>
            <groupId>com.nexusai</groupId>
            <artifactId>nexusai-persistence-log-template</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- MyBatis 框架（编译期）·PostgreSQL 驱动 postgresql 为 runtime 依赖，由 server-starter「数据库驱动依赖」分区统一提供，本模块不绑驱动 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
